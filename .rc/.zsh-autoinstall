#!/bin/zsh
# Zsh Auto-Installer (.rc/.zsh-autoinstall)
# Automatically installs Oh My Zsh, plugins, and other dependencies

# Install Oh My Zsh if not present
if [[ ! -d ~/.oh-my-zsh ]]; then
  echo "Installing Oh My Zsh..."
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

# Install Powerlevel10k theme
if [[ ! -d ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k ]]; then
  echo "Installing Powerlevel10k theme..."
  git clone https://github.com/romkatv/powerlevel10k.git ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k
fi

# Install fzf-tab plugin
if [[ ! -d ${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/fzf-tab ]]; then
  git clone https://github.com/Aloxaf/fzf-tab ${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/fzf-tab
fi

# Install zsh-completions plugin
if [[ ! -d ${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions ]]; then
  git clone https://github.com/zsh-users/zsh-completions ${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions
fi

# Install you-should-use plugin
if [[ ! -d ${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/you-should-use ]]; then
  git clone https://github.com/MichaelAquilina/zsh-you-should-use.git ${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/you-should-use
fi

# Install zsh-syntax-highlighting plugin
if [[ ! -d ${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-syntax-highlighting ]]; then
  git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-syntax-highlighting
fi

# Install zsh-autosuggestions plugin
if [[ ! -d ${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-autosuggestions ]]; then
  git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-autosuggestions
fi

# Install mcp-grafana Go binary
if [ ! -f "$HOME/go/bin/mcp-grafana" ] && command -v go &> /dev/null; then
  go install github.com/grafana/mcp-grafana/cmd/mcp-grafana@latest
fi

# Install global npm CLIs listed in .rc/.npm-globals
# Presence is checked with `command -v` (a shell builtin) rather than
# `npm ls -g`, so this costs nothing on a warm machine.
if command -v npm >/dev/null 2>&1 && [[ -r ~/.rc/.npm-globals ]]; then
  () {
    local -a missing all
    local pkg bin line
    local stamp=~/.cache/npm-globals-updated

    while read -r pkg bin; do
      [[ -z "$pkg" || "$pkg" == \#* ]] && continue
      all+=("$pkg")
      command -v "$bin" >/dev/null 2>&1 || missing+=("$pkg")
    done < ~/.rc/.npm-globals

    if (( ${#missing} )); then
      echo "Installing global npm CLIs: ${missing[*]}"
      npm install -g "${missing[@]}"
    fi

    # Update weekly, in the background so it never blocks a shell.
    if (( ${#all} )); then
      mkdir -p ~/.cache
      if [[ ! -f "$stamp" ]] || [[ -n "$(find "$stamp" -mtime +7 2>/dev/null)" ]]; then
        ( npm update -g "${all[@]}" >/dev/null 2>&1 && touch "$stamp" ) &!
      fi
    fi
  }
fi
